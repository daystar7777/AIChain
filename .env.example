# Copy to .env and fill in. .env is git-ignored.
# OpenCode Go API key (https://opencode.ai). Used by the opencode-go LLM adapter.
OPENCODE_GO_API_KEY=
# Brave Search API (paid per query). Used for search; capped by --search-daily-cap (default 60/day).
BRAVE_SEARCH_API_KEY=
# Telegram bridge for the node manager (python -m aichain.telegram_bridge)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
