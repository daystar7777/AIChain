# Copy to .env and fill in. .env is git-ignored.
# OpenCode Go API key (oc_sk_..., from OpenCode Console, in the workspace with the Go
# subscription). Used by the opencode-go LLM adapter.
OPENCODE_GO_API_KEY=
# Optional: override the Go base URL if OpenCode moves it again.
# OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Brave Search API (paid per query). Used for search; capped by --search-daily-cap (default 60/day).
BRAVE_SEARCH_API_KEY=
# Telegram bridge for the node manager (python -m aichain.telegram_bridge)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
