# Telegram bridge for the node manager. Needs TELEGRAM_BOT_TOKEN (and TELEGRAM_MANAGER_CHAT_ID)
# in /opt/aichain/.env. Enable once the token is in place:
#   systemctl enable --now aichain-telegram
[Unit]
Description=AIChain Telegram bridge (node manager)
After=aichain-bridge.service
Wants=aichain-bridge.service
# Keep retrying (with growing delays) and alert on every failure (aichain-alert@).
StartLimitIntervalSec=0
OnFailure=aichain-alert@%n.service

[Service]
WorkingDirectory=/opt/aichain
ExecStart=/opt/aichain/.venv/bin/python -m aichain.telegram_bridge
Restart=on-failure
RestartSec=15
RestartSteps=6
RestartMaxDelaySec=15min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/aichain/data
# Memory: a long-poll loop with an HTTP client (~50 MB).
MemoryHigh=128M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
